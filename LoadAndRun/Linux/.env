# Django
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.10.196,backend,nginx
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://192.168.10.196:5173

# Database (внутри Docker-сети хост — имя сервиса "db")
POSTGRES_DB=eye_of_the_reservoir
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/eye_of_the_reservoir

# Celery / Redis (внутри Docker-сети хост — имя сервиса "redis")
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Задачи выполняются синхронно в процессе Django, без брокера.
# True — если НЕ хочешь поднимать celery worker / beat.
# False — если хочешь, чтобы celery worker и beat реально работали через Redis.
CELERY_TASK_ALWAYS_EAGER=True

# Внешний API-сервис (см. fields/api_sources.py) — автоматический опрос по Celery Beat.
KRON_MNKT_API_BASE_URL=
KRON_MNKT_API_LOGIN=
KRON_MNKT_API_PASSWORD=